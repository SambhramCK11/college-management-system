# Copy to .env for local development. On Vercel, set these in
# Settings -> Environment Variables instead.

SECRET_KEY=change-me-to-a-long-random-string

DB_HOST=localhost
DB_NAME=college
DB_USER=postgres
DB_PASSWORD=
DB_PORT=5432

# "require" for hosted Postgres (Neon, Supabase, Vercel Postgres).
# "prefer" for a plain local server.
DB_SSLMODE=prefer
