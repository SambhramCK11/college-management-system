  "edit_subject.html": "<!DOCTYPE html>\n<html>\n\n<head>\n    <title>Edit Subject</title>\n</head>\n\n<body>\n\n<h1>Edit Subject</h1>\n\n<form method=\"POST\">\n\nSubject Code<br>\n\n<input\ntype=\"text\"\nname=\"subject_code\"\nvalue=\"CS301\"\nrequired>\n\n<br><br>\n\nSubject Name<br>\n\n<input\ntype=\"text\"\nname=\"subject_name\"\nvalue=\"Algorithms\"\nrequired>\n\n<br><br>\n\nDepartment<br>\n\n<select name=\"department\">\n\n\n\n<option\nvalue=\"1\"\nselected>\n\nCSE\n\n</option>\n\n\n\n<option\nvalue=\"2\"\n>\n\nECE\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\nSemester<br>\n\n<input\ntype=\"number\"\nname=\"semester\"\nvalue=\"3\">\n\n<br><br>\n\nFaculty<br>\n\n<select name=\"faculty\">\n\n\n\n<option\nvalue=\"1\"\nselected>\n\nDr. Iyer\n\n</option>\n\n\n\n<option\nvalue=\"2\"\n>\n\nDr. &#34;Rao&#34;\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\n<button type=\"submit\">\n\nUpdate Subject\n\n</button>\n\n</form>\n\n<br>\n\n<a href=\"/subjects\">\n\nBack\n\n</a>\n\n</body>\n\n</html>",
  "faculty.html": "<!DOCTYPE html>\n<html>\n\n<head>\n\n<title>Faculty</title>\n<link\nrel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n\n</head>\n\n<body>\n\n<h1>Faculty Management</h1>\n\n<a href=\"/dashboard\">Dashboard</a>\n\n|\n\n<a href=\"/add_faculty\">\n\nAdd Faculty\n\n</a>\n<br><br>\n\n<form action=\"/search_faculty\" method=\"GET\">\n\n<input\ntype=\"text\"\nname=\"search\"\nplaceholder=\"Search by ID, Name or Mobile\">\n\n<button type=\"submit\">\n\nSearch\n\n</button>\n\n</form>\n\n<br>\n\n<br><br>\n\n<table border=\"1\" cellpadding=\"10\">\n\n<tr>\n\n<th>ID</th>\n\n<th>Name</th>\n\n<th>Department</th>\n\n<th>Qualification</th>\n\n<th>Experience</th>\n\n<th>Mobile</th>\n\n<th>Email</th>\n\n<th>Action</th>\n\n</tr>\n\n\n\n<tr>\n\n<td>1</td>\n\n<td>Dr. Iyer</td>\n\n<td>1</td>\n\n<td>PhD</td>\n\n<td>12</td>\n\n<td>9998887777</td>\n\n<td>iyer@example.com</td>\n\n<td>\n\n<a href=\"/edit_faculty/1\">\n\nEdit\n\n</a>\n\n|\n\n<a href=\"/delete_faculty/1\">\n\nDelete\n\n</a>\n\n</td>\n\n</tr>\n\n\n\n<tr>\n\n<td>2</td>\n\n<td>Dr. &#34;Rao&#34;</td>\n\n<td>2</td>\n\n<td>ME</td>\n\n<td>8</td>\n\n<td>9998887778</td>\n\n<td>rao@example.com</td>\n\n<td>\n\n<a href=\"/edit_faculty/2\">\n\nEdit\n\n</a>\n\n|\n\n<a href=\"/delete_faculty/2\">\n\nDelete\n\n</a>\n\n</td>\n\n</tr>\n\n\n\n</table>\n\n</body>\n\n</html>",
  "fees.html": "<!DOCTYPE html>\n\n<html>\n\n<head>\n\n<title>Fee Management</title>\n<link\nrel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n</head>\n\n<body>\n\n<h1>Fee Management</h1>\n\n<form method=\"POST\">\n\nStudent\n\n<br>\n\n<select name=\"student\">\n\n\n\n<option value=\"1\">\n\nAsha Rao\n\n</option>\n\n\n\n<option value=\"2\">\n\nBob &lt;script&gt;\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\nTotal Fee\n\n<br>\n\n<label>Fee Amount</label>\n\n<input\n    type=\"number\"\n    name=\"fee_amount\"\n    step=\"0.01\"\n    required>\n\n<br><br>\n\nPaid Amount\n\n<br>\n\n<input\ntype=\"number\"\nname=\"paid_amount\"\nrequired>\n\n<br><br>\n\nPayment Date\n\n<br>\n\n<input\ntype=\"date\"\nname=\"payment_date\"\nrequired>\n\n<br><br>\n\n<button>\n\nSave Fee\n\n</button>\n\n</form>\n\n</body>\n\n</html>",
