  "departments.html": "<!DOCTYPE html>\n<html>\n\n<head>\n    <title>Departments</title>\n<link\nrel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n\n</head>\n\n<body>\n\n<h1>Department Management</h1>\n\n<a href=\"/dashboard\">Dashboard</a>\n\n|\n\n<a href=\"/add_department\">Add Department</a>\n\n<br><br>\n\n<table border=\"1\" cellpadding=\"10\">\n\n<tr>\n\n<th>ID</th>\n\n<th>Department</th>\n\n<th>HOD</th>\n\n<th>Actions</th>\n\n</tr>\n\n\n\n<tr>\n\n<td>1</td>\n\n<td>CSE</td>\n\n<td>Dr. Iyer</td>\n\n<td>\n\n<a href=\"/edit_department/1\">Edit</a>\n\n|\n\n<a href=\"/delete_department/1\">Delete</a>\n\n</td>\n\n</tr>\n\n\n\n<tr>\n\n<td>2</td>\n\n<td>ECE</td>\n\n<td>Dr. Rao &amp; Sons</td>\n\n<td>\n\n<a href=\"/edit_department/2\">Edit</a>\n\n|\n\n<a href=\"/delete_department/2\">Delete</a>\n\n</td>\n\n</tr>\n\n\n\n</table>\n\n</body>\n\n</html>",
  "edit_attendance.html": "<!DOCTYPE html>\n<html>\n\n<head>\n    <title>Edit Attendance</title>\n<link\nrel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n</head>\n\n<body>\n\n<h1>Edit Attendance</h1>\n\n<form method=\"POST\">\n\nStudent\n\n<br>\n\n<select name=\"student\">\n\n\n\n<option value=\"1\"\nselected>\n\nAsha Rao\n\n</option>\n\n\n\n<option value=\"2\"\n>\n\nBob &lt;script&gt;\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\nSubject\n\n<br>\n\n<select name=\"subject\">\n\n\n\n<option value=\"1\"\nselected>\n\nCS301\n\n</option>\n\n\n\n<option value=\"2\"\n>\n\nEC201\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\nDate\n\n<br>\n\n<input\ntype=\"date\"\nname=\"date\"\nvalue=\"2026-09-20\">\n\n<br><br>\n\nStatus\n\n<br>\n\n<select name=\"status\">\n\n<option selected>Present</option>\n\n<option >Absent</option>\n\n</select>\n\n<br><br>\n\n<button>\n\nUpdate Attendance\n\n</button>\n\n</form>\n\n</body>\n\n</html>",
  "edit_department.html": "<!DOCTYPE html>\n<html>\n\n<head>\n\n<title>Edit Department</title>\n<link\nrel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n\n</head>\n\n<body>\n\n<h1>Edit Department</h1>\n\n<form method=\"POST\">\n\nDepartment Name\n\n<br>\n\n<input\ntype=\"text\"\nname=\"department_name\"\nvalue=\"CSE\"\nrequired>\n\n<br><br>\n\nHOD Name\n\n<br>\n\n<input\ntype=\"text\"\nname=\"hod_name\"\nvalue=\"Dr. Iyer\"\nrequired>\n\n<br><br>\n\n<button type=\"submit\">\n\nUpdate\n\n</button>\n\n</form>\n\n<br>\n\n<a href=\"/departments\">\n\nBack\n\n</a>\n\n</body>\n\n</html>",
