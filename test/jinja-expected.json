{
  "404.html": "<!DOCTYPE html>\n<html>\n\n<head>\n\n<title>404 - Page Not Found</title>\n\n<link rel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n\n</head>\n\n<body>\n\n<h1>404</h1>\n\n<h2>Page Not Found</h2>\n\n<p>The page you are looking for does not exist.</p>\n\n<br>\n\n<a href=\"/dashboard\">Go to Dashboard</a>\n\n</body>\n\n</html>",
  "500.html": "<!DOCTYPE html>\n<html>\n\n<head>\n\n<title>500 - Server Error</title>\n\n<link rel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n\n</head>\n\n<body>\n\n<h1>500</h1>\n\n<h2>Internal Server Error</h2>\n\n<p>Something went wrong.</p>\n\n<p>Please try again later.</p>\n\n<br>\n\n<a href=\"/dashboard\">Back to Dashboard</a>\n\n</body>\n\n</html>",
  "add_department.html": "<!DOCTYPE html>\n<html>\n\n<head>\n\n<title>Add Department</title>\n\n<link rel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n\n</head>\n\n<body>\n\n<h1>Add Department</h1>\n\n<form method=\"POST\">\n\n<label>Department Name</label>\n\n<input\ntype=\"text\"\nname=\"department_name\"\nrequired>\n\n<br><br>\n\n<label>HOD Name</label>\n\n<input\ntype=\"text\"\nname=\"hod_name\"\nrequired>\n\n<br><br>\n\n<button type=\"submit\">\n\nAdd Department\n\n</button>\n\n</form>\n\n<br>\n\n<a href=\"/departments\">\n\nBack\n\n</a>\n\n</body>\n\n</html>",
  "add_faculty.html": "<!DOCTYPE html>\n<html>\n\n<head>\n\n<title>Add Faculty</title>\n\n</head>\n\n<body>\n\n<h1>Add Faculty</h1>\n\n<form method=\"POST\">\n\nFaculty Name\n\n<br>\n\n<input type=\"text\" name=\"faculty_name\" required>\n\n<br><br>\n\nDepartment\n\n<br>\n\n<select name=\"department\">\n\n\n\n<option value=\"1\">\n\nCSE\n\n</option>\n\n\n\n<option value=\"2\">\n\nECE\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\nQualification\n\n<br>\n\n<input type=\"text\" name=\"qualification\">\n\n<br><br>\n\nExperience (Years)\n\n<br>\n\n<input type=\"number\" name=\"experience\">\n\n<br><br>\n\nMobile\n\n<br>\n\n<input type=\"text\" name=\"mobile\">\n\n<br><br>\n\nEmail\n\n<br>\n\n<input type=\"email\" name=\"email\">\n\n<br><br>\n\n<button type=\"submit\">\n\nSave Faculty\n\n</button>\n\n</form>\n\n<br>\n\n<a href=\"/faculty\">\n\nBack\n\n</a>\n\n</body>\n\n</html>",
  "add_student.html": "<!DOCTYPE html>\n<html>\n\n<head>\n\n<title>Add Student</title>\n\n</head>\n\n<body>\n\n<h1>Add Student</h1>\n\n<form method=\"POST\">\n\nStudent Name\n\n<br>\n\n<input type=\"text\" name=\"student_name\" required>\n\n<br><br>\n\nGender\n\n<br>\n\n<select name=\"gender\">\n\n<option>Male</option>\n\n<option>Female</option>\n\n</select>\n\n<br><br>\n\nDate Of Birth\n\n<br>\n\n<input type=\"date\" name=\"dob\">\n\n<br><br>\n\nMobile\n\n<br>\n\n<input type=\"text\" name=\"mobile\">\n\n<br><br>\n\nEmail\n\n<br>\n\n<input type=\"email\" name=\"email\">\n\n<br><br>\n\nAddress\n\n<br>\n\n<textarea name=\"address\"></textarea>\n\n<br><br>\n\nDepartment\n\n<br>\n\n<select name=\"department\">\n\n\n\n<option value=\"1\">\n\nCSE\n\n</option>\n\n\n\n<option value=\"2\">\n\nECE\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\nSemester\n\n<br>\n\n<input type=\"number\" name=\"semester\">\n\n<br><br>\n\n<button type=\"submit\">\n\nSave Student\n\n</button>\n\n</form>\n\n<br>\n\n<a href=\"/students\">\n\nBack\n\n</a>\n\n</body>\n\n</html>",
  "add_subject.html": "<!DOCTYPE html>\n<html>\n\n<head>\n<title>Add Subject</title>\n</head>\n\n<body>\n\n<h1>Add Subject</h1>\n\n<form method=\"POST\">\n\nSubject Code\n\n<br>\n\n<input\ntype=\"text\"\nname=\"subject_code\"\nrequired>\n\n<br><br>\n\nSubject Name\n\n<br>\n\n<input\ntype=\"text\"\nname=\"subject_name\"\nrequired>\n\n<br><br>\n\nDepartment\n\n<br>\n\n<select name=\"department\">\n\n\n\n<option value=\"1\">\n\nCSE\n\n</option>\n\n\n\n<option value=\"2\">\n\nECE\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\nSemester\n\n<br>\n\n<input\ntype=\"number\"\nname=\"semester\"\nrequired>\n\n<br><br>\n\nFaculty\n\n<br>\n\n<select name=\"faculty\">\n\n\n\n<option value=\"1\">\n\nDr. Iyer\n\n</option>\n\n\n\n<option value=\"2\">\n\nDr. &#34;Rao&#34;\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\n<button type=\"submit\">\n\nSave Subject\n\n</button>\n\n</form>\n\n<br>\n\n<a href=\"/subjects\">Back</a>\n\n</body>\n\n</html>",
  "attendance.html": "<!DOCTYPE html>\n\n<html>\n\n<head>\n\n<title>Attendance</title>\n<link\nrel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n</head>\n\n<body>\n\n<h1>Mark Attendance</h1>\n\n<form method=\"POST\">\n\nStudent\n\n<br>\n\n<select name=\"student\">\n\n\n\n<option value=\"1\">\n\nAsha Rao\n\n</option>\n\n\n\n<option value=\"2\">\n\nBob &lt;script&gt;\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\nSubject\n\n<br>\n\n<select name=\"subject\">\n\n\n\n<option value=\"1\">\n\nCS301\n\n</option>\n\n\n\n<option value=\"2\">\n\nEC201\n\n</option>\n\n\n\n</select>\n\n<br><br>\n\nDate\n\n<br>\n\n<input\n\ntype=\"date\"\n\nname=\"date\"\n\nrequired>\n\n<br><br>\n\nStatus\n\n<br>\n\n<select name=\"status\">\n\n<option>Present</option>\n\n<option>Absent</option>\n\n</select>\n\n<br><br>\n\n<button type=\"submit\">\n\nSave Attendance\n\n</button>\n\n</form>\n\n</body>\n\n</html>",
  "attendance_report.html": "<!DOCTYPE html>\n\n<html>\n\n<head>\n\n<title>Attendance Report</title>\n\n</head>\n\n<body>\n\n<h1>Attendance Report</h1>\n<form action=\"/search_attendance\">\n\n<input\ntype=\"text\"\nname=\"search\"\nplaceholder=\"Student or Subject\">\n\n<button>\n\nSearch\n\n</button>\n\n</form>\n\n<br>\n\n<a href=\"/attendance\">\n\nMark Attendance\n\n</a>\n\n<br><br>\n\n<table border=\"1\" cellpadding=\"10\">\n\n<tr>\n\n<th>ID</th>\n\n<th>Student</th>\n\n<th>Subject</th>\n\n<th>Date</th>\n\n<th>Status</th>\n\n</tr>\n\n\n\n<tr>\n\n<td>1</td>\n\n<td>Asha Rao</td>\n\n<td>CS301</td>\n\n<td>25.00</td>\n\n<td>60.00</td>\n\n</tr>\n\n\n\n<tr>\n\n<td>2</td>\n\n<td>Bob &lt;script&gt;</td>\n\n<td>EC201</td>\n\n<td>18.00</td>\n\n<td>44.00</td>\n\n</tr>\n\n\n\n</table>\n\n</body>\n\n</html>",
  "dashboard1.html": "<!DOCTYPE html>\n<html>\n\n<head>\n\n    <title>Dashboard</title>\n<link\nrel=\"stylesheet\"\nhref=\"/static/css/style.css\">\n</head>\n\n<body>\n\n<h1>College Management System</h1>\n\n<h2>Admin Dashboard</h2>\n\n<table border=\"1\" cellpadding=\"15\">\n\n<tr>\n    <th>Total Students</th>\n    <td>2</td>\n</tr>\n\n<tr>\n    <th>Total Faculty</th>\n    <td>2</td>\n</tr>\n\n<tr>\n    <th>Total Departments</th>\n    <td>2</td>\n</tr>\n\n<tr>\n    <th>Total Subjects</th>\n    <td>2</td>\n</tr>\n\n<tr>\n    <th>Today's Attendance</th>\n    <td>1</td>\n</tr>\n\n<tr>\n    <th>Pending Fee Records</th>\n    <td>1</td>\n</tr>\n\n</table>\n\n<br>\n\n<h2>Modules</h2>\n\n<ul>\n<table>\n\n<tr>\n\n<th>Module</th>\n\n<th>Open</th>\n\n</tr>\n\n<tr>\n\n<td>Department Management</td>\n\n<td><a href=\"/departments\">Open</a></td>\n\n</tr>\n\n<tr>\n\n<td>Student Management</td>\n\n<td><a href=\"/students\">Open</a></td>\n\n</tr>\n\n<tr>\n\n<td>Faculty Management</td>\n\n<td><a href=\"/faculty\">Open</a></td>\n\n</tr>\n\n<tr>\n\n<td>Subject Management</td>\n\n<td><a href=\"/subjects\">Open</a></td>\n\n</tr>\n\n<tr>\n\n<td>Attendance</td>\n\n<td><a href=\"/attendance\">Open</a></td>\n\n</tr>\n\n<tr>\n\n<td>Marks</td>\n\n<td><a href=\"/marks\">Open</a></td>\n\n</tr>\n\n<tr>\n\n<td>Fee Management</td>\n\n<td><a href=\"/fees\">Open</a></td>\n\n</tr>\n\n<tr>\n\n<td>Attendance Report</td>\n\n<td><a href=\"/attendance_report\">Open</a></td>\n\n</tr>\n\n<tr>\n\n<td>Marks Report</td>\n\n<td><a href=\"/marks_report\">Open</a></td>\n\n</tr>\n\n<tr>\n\n<td>Fee Report</td>\n\n<td><a href=\"/fees_report\">Open</a></td>\n\n</tr>\n\n</table>\n\n</ul>\n\n<br>\n\n<a href=\"/logout\">Logout</a>\n\n</body>\n\n</html>OCTYPE html>\n<html>\n\n<head>\n\n<title>Dashboard</title>\n\n</head>\n\n<body>\n\n<h1>College Management System</h1>\n\n<hr>\n\n<h2>Dashboard</h2>\n\n<h3>Total Students : 2</h3>\n\n<h3>Total Faculty : 2</h3>\n\n<h3>Total Departments : 2</h3>\n\n<h3>Total Subjects : 2</h3>